# --- Bedrock ---
# Model is pinned and config-driven. Sonnet 4.5 because it still accepts
# temperature=0 and is the FedRAMP-High-authorized model in GovCloud.
# Do NOT swap to a 4.6+/5 model without removing every temperature=0.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929
AWS_REGION=us-east-1

# --- AWS credentials ---
# Come from the standard AWS credential chain / IAM role. No keys in code.
# For local dev only, you may set them here (leave blank to use the chain):
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Database ---
# Inside docker compose the host is `postgres`; for local (non-Docker) runs use `localhost`.
DATABASE_URL=postgresql+psycopg://airtight:airtight@localhost:5432/airtight

# --- Voice ---
# Speech-to-text and text-to-speech for the voice rehearsal mode. Uses the
# same AWS credential chain and region as Bedrock above.
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SAMPLE_RATE=16000
POLLY_ENGINE=neural
MAX_ANSWER_AUDIO_BYTES=10485760

# --- Tangent limits ---
# Warn at or above these values; apply the disclosed penalty only above limits.
TEXT_ANSWER_WARNING_WORDS=225
TEXT_ANSWER_LIMIT_WORDS=300
VOICE_ANSWER_WARNING_SECONDS=90
VOICE_ANSWER_LIMIT_SECONDS=120
