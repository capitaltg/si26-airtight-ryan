#!/usr/bin/env bash
# Boot the server (FastAPI via uvicorn --reload). On PATH inside the dev container.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT/server"
# `python -m` avoids depending on ~/.local/bin being on PATH (only login
# shells add it), which non-login terminals don't get.
# WATCHFILES_FORCE_POLLING: the workspace is bind-mounted from macOS host, and
# Docker Desktop's file sharing doesn't propagate inotify events through the
# mount, so --reload's default watcher never fires on host-side saves.
export WATCHFILES_FORCE_POLLING=true
exec python -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000 "$@"
